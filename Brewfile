# Brewfile — machine dependencies. Install with `brew bundle`.
# See configs/README.md for what the shell tools replace/provide.

# ── Shell tools ──
brew "eza"                    # modern ls
brew "bat"                    # modern cat
brew "fd"                     # modern find (also backs fzf + yazi search)
brew "ripgrep"                # fast grep (rg)
brew "zoxide"                 # smarter cd
brew "yazi"                   # terminal file manager
brew "fzf"                    # fuzzy finder
brew "starship"               # prompt
brew "zsh-autosuggestions"    # fish-like autosuggestions
brew "zsh-syntax-highlighting" # command syntax highlighting

# ── yazi preview deps ──
brew "poppler"                # PDF previews in yazi
brew "ffmpeg"                 # video thumbnails/previews in yazi

# ── CLI ──
brew "gh"                     # GitHub CLI
brew "fnm"                    # fast Node version manager
brew "jq"                     # JSON processor
brew "trash"                  # safe rm → macOS Trash

# ── Apps ──
cask "visual-studio-code"     # editor
cask "orbstack"               # docker/compose runtime + Linux VMs (lighter than Docker Desktop)
